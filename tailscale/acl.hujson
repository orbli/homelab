// Tailnet ACL (orbb.li primary tailnet).
//
// Reconciled to Tailscale's control plane by
// .github/workflows/tailscale-sync.yml on every push to master that
// touches tailscale/**. Tailnet identifier lives in the TS_TAILNET
// GH Actions secret, not in this repo.
//
// Default behavior: DENY. Every rule below is an explicit accept.
// Without a matching accept rule, no traffic flows.

{
    // ------------------------------------------------------------------
    // Groups: user collections for use in acls/ssh rules. Deliberately
    // empty: the policy names the three current members by email
    // everywhere a principal list is needed (see the acls below), so a
    // newly joined member matches NOTHING until an email is added.
    // ------------------------------------------------------------------
    "groups": {},

    // ------------------------------------------------------------------
    // Tag owners: which principals can apply each tag to devices.
    // Tag application happens out-of-band via `tailscale up --advertise-tags=`
    // or in the admin console; this section just authorizes who's
    // allowed to assert them. Inherited verbatim from the prior ACL.
    // ------------------------------------------------------------------
    "tagOwners": {
        "tag:k8s-operator": [],
        "tag:k8s":          ["tag:k8s-operator"],
        "tag:k8s-host":     ["autogroup:admin"],
        "tag:exit-node":    ["autogroup:admin"],
        // tag:homelab marks "my home infrastructure" devices that
        // should also serve as exit nodes for the rest of the tailnet
        // (see autoApprovers.exitNode + the autogroup:internet ACL
        // rule below). Owner restricted to mail@orbb.li — no one else
        // can assert this tag.
        "tag:homelab":      ["mail@orbb.li"],
        // tag:spark marks the two GB10 Spark boxes (home-hk2-spark1/2).
        // It is deliberately NOT a `src` in any acl rule: a Spark can be
        // reached inbound by whoever holds an accept rule pointing at it,
        // but can never initiate a tailnet connection itself (default
        // deny). Owner restricted to mail@orbb.li.
        "tag:spark":        ["mail@orbb.li"],
    },

    // ------------------------------------------------------------------
    // Host aliases: short names for use in acls.dst. Self-defined names
    // (intentionally exposed in this file). Avoid using Tailscale-
    // assigned identifiers like the tailnet's *.ts.net suffix.
    // ------------------------------------------------------------------
    "hosts": {
        "company-hk3-nas":  "100.119.56.40",
        // Spark boxes by stable tailnet IP, so a network rule can target
        // ONE Spark (tags cover both). SSH rules cannot use hosts, only
        // tags, so SSH grants always land on tag:spark = both boxes.
        "home-hk2-spark1":  "100.99.244.49",
        "home-hk2-spark2":  "100.112.234.109",
    },

    // ------------------------------------------------------------------
    // ACL rules. First match wins; default DENY if no rule matches.
    // ------------------------------------------------------------------
    "acls": [
        // Admins (you + zura35) AND all tagged infra machines:
        // unrestricted access tailnet-wide. Tagged machines need full
        // reach because they are k8s nodes / the tailscale-connector
        // pod / homelab infra that needs to talk to anything inside
        // the cluster.
        {
            "action": "accept",
            "src": [
                "mail@orbb.li",
                "zura35@gmail.com",
                "tag:k8s-operator",
                "tag:k8s",
                "tag:k8s-host",
                "tag:exit-node",
                "tag:homelab",
            ],
            "dst": ["*:*"],
        },

        // Filebrowser-gate's port: open to the three current members at
        // the network layer. The actual authorization is at the
        // application layer (oauth2-proxy + Keycloak; only users in the
        // Keycloak mgroup realm group get past the OIDC check). Members
        // are listed by email on purpose (was autogroup:member): a newly
        // invited user gets NO reachability until their email is added
        // here. No SSH, no jellyfin, no Container Station UI, no QNAP
        // admin UI, no other port on the NAS is exposed by this rule.
        {
            "action": "accept",
            "src": [
                "mail@orbb.li",
                "zura35@gmail.com",
                "skyhook.orange@gmail.com",
            ],
            "dst": ["company-hk3-nas:14180"],
        },

        // The three current members can use ANY designated exit node for
        // their internet-bound traffic. `autogroup:internet` is the
        // canonical Tailscale destination for "route through this
        // device to the public internet" — it grants ONLY internet
        // pipe-through, NOT port access to the exit-node device. So
        // a member running `tailscale up --exit-node=<a-homelab-host>`
        // can route their internet through it, but cannot reach the
        // homelab device's own SSH/HTTP/anything on any port. Port
        // access is governed by other rules above (default deny).
        // Listed by email (was autogroup:member) so a new member gets no
        // exit-node access by default; a pinned-exit-node grant for a
        // guest lives in the `grants` section below instead.
        {
            "action": "accept",
            "src": [
                "mail@orbb.li",
                "zura35@gmail.com",
                "skyhook.orange@gmail.com",
            ],
            "dst": ["autogroup:internet:*"],
        },

        // --- Guest template (disabled) -------------------------------
        // A guest who may use ONE Spark and nothing else. Uncomment and
        // fill in the email. Network layer only; SSH is the `ssh` rule
        // template further down, exit node is the `grants` template.
        // {
        //     "action": "accept",
        //     "src":    ["guest@example.com"],
        //     "dst":    ["home-hk2-spark1:*"],
        // },
    ],

    // ------------------------------------------------------------------
    // Tailscale SSH rules. Govern Tailscale's embedded SSH server
    // (separate ruleset from acls above). `check` = require Tailscale
    // session-key + UI confirmation; `accept` = no extra check beyond
    // the underlying ACL accept.
    // ------------------------------------------------------------------
    "ssh": [
        // Current members can SSH into their own devices (laptop ->
        // laptop etc). Listed by email (was autogroup:member) so even
        // self-SSH is off for a freshly joined user until added here.
        {
            "action": "check",
            "src": [
                "mail@orbb.li",
                "zura35@gmail.com",
                "skyhook.orange@gmail.com",
            ],
            "dst":    ["autogroup:self"],
            "users":  ["autogroup:nonroot", "root"],
        },
        // mail@orbb.li connects freely to homelab infra: no `check`
        // re-auth prompt. First-match-wins, so this scoped `accept`
        // must sit ABOVE the broader admin `check` rule below. Scope is
        // deliberately narrow — only mail@orbb.li, only tag:homelab.
        // zura35 and the other infra tags stay on `check` via the
        // rules below.
        {
            "action": "accept",
            "src":    ["mail@orbb.li"],
            "dst":    ["tag:homelab", "tag:spark"],
            "users":  ["autogroup:nonroot", "root"],
        },
        // Jenny (zura35) operates the mcgt business from home-gb1-pi1
        // (Manchester Pi, tag:homelab): `ssh mcgt@home-gb1-pi1`.
        // Granted by email so it does NOT depend on her holding the
        // Admin role in the console (the admin rule below would only
        // cover her if she does). Scope: the `mcgt` unix user only.
        // SSH rules can't target a single tagged host, so dst is
        // tag:homelab — in practice only home-gb1-pi1 has an `mcgt`
        // account, so the login fails on every other homelab node.
        // If that ever stops being true, give the Pi its own tag and
        // narrow dst to it. `check` (browser re-auth, 12h) matches
        // the convention for everyone except mail@orbb.li.
        {
            "action": "check",
            "src":    ["zura35@gmail.com"],
            "dst":    ["tag:homelab", "tag:spark"],
            "users":  ["mcgt"],
        },
        // Admins can SSH into tagged infra hosts.
        {
            "action": "check",
            "src":    ["autogroup:admin"],
            "dst":    ["tag:k8s-host", "tag:exit-node", "tag:homelab", "tag:spark"],
            "users":  ["autogroup:nonroot", "root"],
        },

        // --- Guest template (disabled) -------------------------------
        // Guest SSH onto the Spark as a dedicated, non-sudo, non-docker
        // unix user (create it first: `sudo adduser guest`). `check` =
        // browser re-auth every 12h. dst is tag:spark (= both boxes;
        // SSH rules can't name one host) but only spark1 runs Tailscale
        // SSH (`RunSSH`), and only spark1 has the unix user, so spark2
        // refuses anyway.
        // {
        //     "action": "check",
        //     "src":    ["guest@example.com"],
        //     "dst":    ["tag:spark"],
        //     "users":  ["guest"],
        // },
    ],

    // ------------------------------------------------------------------
    // Grants (newer syntax; coexists with `acls`, both are additive).
    // Used only where plain acls can't express it: the `via` field pins
    // internet egress to exit nodes carrying a given tag.
    // ------------------------------------------------------------------
    "grants": [
        // --- Guest template (disabled) -------------------------------
        // Guest may use ONLY home-hk1-cluster-connector as exit node.
        // `via` must be a tag; the connector is tag:homelab + tag:k8s.
        // tag:homelab is on six exit-capable boxes, but tag:k8s is on
        // the connector plus the k8s-operator proxy pods, none of which
        // advertise an exit node — so via tag:k8s = the connector only.
        // The guest must NOT appear in the autogroup:internet acl above,
        // or that unpinned rule would let them use any exit node.
        // {
        //     "src": ["guest@example.com"],
        //     "dst": ["autogroup:internet"],
        //     "via": ["tag:k8s"],
        //     "ip":  ["*"],
        // },
    ],

    // ------------------------------------------------------------------
    // SSH policy tests. Evaluated by Tailscale's control plane on every
    // sync; a failing assertion REJECTS the whole policy push, so the
    // live ACL can never silently lose these grants.
    // ------------------------------------------------------------------
    "sshTests": [
        // Jenny can log in as mcgt on homelab nodes (i.e. home-gb1-pi1),
        // subject to a check prompt.
        {
            "src":   "zura35@gmail.com",
            "dst":   ["tag:homelab", "tag:spark"],
            "check": ["mcgt"],
        },
        // NOTE: there is deliberately no `accept` assertion for
        // mail@orbb.li -> tag:homelab. The validator reports `check`
        // for that pair: Tailscale evaluates SSH rules most-restrictive
        // first (all `check` rules, then `accept`), NOT in file order,
        // and mail@orbb.li also matches the autogroup:admin `check`
        // rule. So the scoped `accept` rule above does not currently
        // win. Fixing that means taking mail@orbb.li out of the admin
        // check rule's src (list the other admins explicitly).
    ],

    // ------------------------------------------------------------------
    // Network policy tests. Same semantics as sshTests: a failing
    // assertion rejects the push. These pin the invariants this file
    // exists to hold.
    // ------------------------------------------------------------------
    "tests": [
        // Current members keep the filebrowser gate.
        {
            "src":    "skyhook.orange@gmail.com",
            "accept": ["company-hk3-nas:14180"],
            "deny":   ["company-hk3-nas:22", "home-hk2-spark1:22"],
        },
        // A Spark can initiate NOTHING on the tailnet.
        {
            "src":  "tag:spark",
            "deny": ["company-hk3-nas:14180", "home-hk2-spark2:22"],
        },
    ],

    // ------------------------------------------------------------------
    // Auto-approved subnet route advertisements. Without this, every
    // time the tailscale-connector pod restarts and re-advertises
    // these CIDRs, an admin would have to click "approve" in the
    // admin console. With it, restarts are seamless.
    //
    //   10.42.0.0/16  = k8s pod CIDR  (cluster-wide pod IPs)
    //   10.43.0.0/16  = k8s service CIDR (ClusterIP services)
    //
    // Only mail@orbb.li or anything with tag:k8s can advertise these;
    // a stray device announcing 10.42/16 would NOT be auto-approved.
    // ------------------------------------------------------------------
    "autoApprovers": {
        "routes": {
            "10.42.0.0/16": ["mail@orbb.li", "tag:k8s"],
            "10.43.0.0/16": ["mail@orbb.li", "tag:k8s"],
        },
        // Auto-approve any tag:homelab device's exit-node assertion.
        // Without this, an admin would have to click "approve" in
        // the Tailscale admin console each time a tag:homelab device
        // (re)joins the tailnet or restarts and re-asserts itself as
        // an exit node. With it, the members->autogroup:internet ACL
        // above can use these devices as exit nodes immediately.
        "exitNode": ["tag:homelab"],
    },

    // ------------------------------------------------------------------
    // Node attributes. `funnel` lets a member run `tailscale funnel`
    // to publicly expose their own device on *.ts.net.
    //
    // Scope: the three current members by email (was autogroup:member).
    // Funnel exposes THEIR device, not yours, but a new member should
    // not get it until deliberately added here.
    // ------------------------------------------------------------------
    "nodeAttrs": [
        {
            "target": [
                "mail@orbb.li",
                "zura35@gmail.com",
                "skyhook.orange@gmail.com",
            ],
            "attr":   ["funnel"],
        },
    ],
}
